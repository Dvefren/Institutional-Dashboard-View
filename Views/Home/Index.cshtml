@model UTTN.Dashboard.ViewModels.Dashboard.RectorateViewModel
@{
    ViewData["Title"] = "Inicio — Vista General";
    var totalGender = Model.MaleCount + Model.FemaleCount + Model.OtherGenderCount;
    var cuatNames = new Dictionary<int, string> { { 0, "Todo el año" }, { 1, "Ene — Abr" }, { 2, "May — Ago" }, { 3, "Sep — Dic" } };
}

<style>
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .kpi-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--shadow-sm);
    }

        .kpi-card .kpi-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .kpi-card .kpi-value {
            font-size: 30px;
            font-weight: 700;
            line-height: 1;
        }

        .kpi-card .kpi-sub {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .kpi-card .kpi-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .kpi-card .kpi-icon svg {
                width: 22px;
                height: 22px;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
                fill: none;
            }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text-primary);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-title svg {
            width: 20px;
            height: 20px;
            stroke: var(--accent);
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .chart-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }

    .chart-box {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }

    .chart-box-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text-primary);
        margin-bottom: 16px;
    }

    .chart-container {
        position: relative;
        width: 100%;
        height: 280px;
    }

    .chart-container-donut {
        position: relative;
        width: 100%;
        height: 260px;
    }

    .filter-bar {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        box-shadow: var(--shadow-sm);
    }

        .filter-bar label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .filter-bar select {
            padding: 8px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            color: var(--text-primary);
            background: white;
            cursor: pointer;
            outline: none;
        }

        .filter-bar .btn-apply {
            padding: 8px 20px;
            background: var(--accent);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s;
        }

            .filter-bar .btn-apply:hover {
                background: var(--accent-hover);
            }

        .filter-bar .btn-clear {
            padding: 8px 16px;
            background: var(--bg-input);
            color: var(--text-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            cursor: pointer;
        }

    .active-filter {
        background: var(--accent-light);
        border: 1px solid var(--accent);
        border-radius: var(--radius-sm);
        padding: 8px 16px;
        font-size: 12px;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 16px;
        display: inline-block;
    }

    .filter-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        flex-wrap: wrap;
        gap: 10px;
    }

        .filter-row select {
            padding: 7px 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            color: var(--text-primary);
            background: white;
            cursor: pointer;
            outline: none;
        }

    .record-count {
        font-size: 12px;
        color: var(--text-muted);
        margin-bottom: 8px;
    }
</style>

@if (ViewBag.Error != null)
{
    <div style="background: var(--danger-light); border: 1px solid rgba(239,68,68,0.2); border-radius: var(--radius-sm); padding: 14px 16px; margin-bottom: 20px; color: var(--danger); font-size: 13px;">
        <strong>Error:</strong> @ViewBag.Error
    </div>
}

<!-- Period Filter -->
<form method="get" class="filter-bar">
    <label>Año:</label>
    <select name="year" id="filterYear">
        @foreach (var y in Model.AvailableYears)
        {
            if (y == Model.SelectedYear)
            {
                <option value="@y" selected="selected">@y</option>
            }
            else
            {
                <option value="@y">@y</option>
            }
        }
    </select>
    <label>Cuatrimestre:</label>
    <select name="cuatrimestre" id="filterCuat">
        @{
            var cuatOptions = new Dictionary<int, string> {
                {0, "Todo el año"}, {1, "Ene — Abr"}, {2, "May — Ago"}, {3, "Sep — Dic"}
                };
        }
        @foreach (var opt in cuatOptions)
        {
            if (opt.Key == Model.SelectedCuatrimestre)
            {
                <option value="@opt.Key" selected="selected">@opt.Value</option>
            }
            else
            {
                <option value="@opt.Key">@opt.Value</option>
            }
        }
    </select>
    <button type="submit" class="btn-apply">Aplicar</button>
    <a href="@Url.Action("Index", "Home")" class="btn-clear">Limpiar</a>
</form>

@if (Model.SelectedCuatrimestre > 0)
{
    <div class="active-filter">Filtro activo: Año @Model.SelectedYear, @cuatNames[Model.SelectedCuatrimestre]</div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div><div class="kpi-label">Estudiantes Registrados</div><div class="kpi-value" style="color: var(--accent);">@Model.TotalStudents</div><div class="kpi-sub">@Model.ActiveStudents inscritos · @Model.Preinscritos preinscritos</div></div>
        <div class="kpi-icon" style="background: var(--accent-light);"><svg viewBox="0 0 24 24" stroke="var(--accent)"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg></div>
    </div>
    <div class="kpi-card">
        <div><div class="kpi-label">Carreras / Grupos</div><div class="kpi-value" style="color: var(--success);">@Model.TotalCareers</div><div class="kpi-sub">@Model.TotalGroups grupos activos</div></div>
        <div class="kpi-icon" style="background: var(--success-light);"><svg viewBox="0 0 24 24" stroke="var(--success)"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg></div>
    </div>
    <div class="kpi-card">
        <div><div class="kpi-label">Docentes</div><div class="kpi-value" style="color: var(--purple);">@Model.TotalTeachers</div></div>
        <div class="kpi-icon" style="background: var(--purple-light);"><svg viewBox="0 0 24 24" stroke="var(--purple)"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg></div>
    </div>
    <div class="kpi-card">
        <div><div class="kpi-label">Trámites Pendientes</div><div class="kpi-value" style="color: var(--warning);">@Model.TotalTramitesPendientes</div><div class="kpi-sub">@Model.TotalVisitasMedicas visitas médicas</div></div>
        <div class="kpi-icon" style="background: var(--warning-light);"><svg viewBox="0 0 24 24" stroke="var(--warning)"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></div>
    </div>
</div>

<!-- 2 Charts: Students by Career bar + Gender donut -->
<div class="chart-row">
    <div class="chart-box">
        <div class="chart-box-title">Estudiantes por Carrera</div>
        @if (Model.StudentsByCareers.Any())
        {
            <div class="chart-container"><canvas id="chartCareers"></canvas></div>
        }
        else
        {

            <p class="no-data">Sin datos para este periodo</p>
        }
    </div>
    <div class="chart-box">
        <div class="chart-box-title">Distribución por Género</div>
        @if (totalGender > 0)
        {
            <div class="chart-container-donut"><canvas id="chartGender"></canvas></div>
        }
        else
        {

            <p class="no-data">Sin datos para este periodo</p>
        }
    </div>
</div>

<!-- Table 1: Estadísticas por Carrera -->
@if (Model.CareersOverview.Any())
{
    <div class="section-title">
        <svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
        Estadísticas por Carrera
    </div>
    <div class="chart-box" style="margin-bottom: 24px;">
        <div class="filter-row">
            <div style="display: flex; gap: 10px; align-items: center;">
                <label style="font-size: 13px; font-weight: 600; color: var(--text-secondary);">Seleccionar Carrera:</label>
                <select onchange="filterTableByColumn(this.value, 'tblCarreras', 0)">
                    <option value="">Todas las carreras</option>
                    @foreach (var c in Model.CareersOverview)
                    {
                        <option value="@c.CareerName">@c.CareerName</option>
                    }
                </select>
            </div>
            <button class="btn-export" onclick="exportTableToCSV('tblCarreras', 'estadisticas_por_carrera.csv')"><svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg> Exportar a Excel</button>
        </div>
        <div class="record-count" id="tblCarrerasCount">Mostrando 1 a @Model.CareersOverview.Count de @Model.CareersOverview.Count registros</div>
        <div style="overflow-x: auto;">
            <table class="data-table" id="tblCarreras">
                <thead><tr><th>Carrera</th><th style="text-align:center;">Total</th><th style="text-align:center;">Inscritos</th><th style="text-align:center;">Preinscritos</th><th style="text-align:center;">Bajas</th><th style="text-align:center;">Grupos</th><th style="text-align:center;">%</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.CareersOverview)
                    {
                        <tr>
                            <td style="font-weight:500;color:var(--text-primary);">@c.CareerName</td>
                            <td style="text-align:center;"><span class="badge badge-accent">@c.TotalStudents</span></td>
                            <td style="text-align:center;"><span class="badge badge-success">@c.Inscritos</span></td>
                            <td style="text-align:center;"><span class="badge badge-warning">@c.Preinscritos</span></td>
                            <td style="text-align:center;"><span class="badge @(c.Bajas > 0 ? "badge-danger" : "badge-neutral")">@c.Bajas</span></td>
                            <td style="text-align:center;"><span class="badge badge-info">@c.Groups</span></td>
                            <td style="text-align:center;"><span class="badge badge-neutral">@c.Percentage%</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Table 2: Estadísticas por Grupo -->
@if (Model.GroupsOverview.Any())
{
    <div class="section-title">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
        Estadísticas por Grupo
    </div>
    <div class="chart-box" style="margin-bottom: 24px;">
        <div class="filter-row">
            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <label style="font-size: 13px; font-weight: 600; color: var(--text-secondary);">Carrera:</label>
                <select onchange="filterTableByColumn(this.value, 'tblGrupos', 1)">
                    <option value="">Todas</option>
                    @foreach (var c in Model.CareersOverview.Where(c => c.TotalStudents > 0))
                    {
                        <option value="@c.CareerName">@c.CareerName</option>
                    }
                </select>
                <label style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-left: 8px;">Turno:</label>
                <select onchange="filterTableByColumn(this.value, 'tblGrupos', 2)">
                    <option value="">Todos</option>
                    <option value="Matutino">Matutino</option>
                    <option value="Vespertino">Vespertino</option>
                </select>
                <label style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-left: 8px;">Cuatrimestre:</label>
                <select onchange="filterTableByColumn(this.value, 'tblGrupos', 3)">
                    <option value="">Todos</option>
                    <option value="1">1er (1A-1B)</option>
                    <option value="3">3er (3A-3B)</option>
                    <option value="5">5to (5A-5B)</option>
                    <option value="7">7mo (7A-7B)</option>
                    <option value="9">9no (9A-9B)</option>
                </select>
            </div>
            <button class="btn-export" onclick="exportTableToCSV('tblGrupos', 'estadisticas_por_grupo.csv')"><svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg> Exportar a Excel</button>
        </div>
        <div class="record-count" id="tblGruposCount">Mostrando 1 a @Model.GroupsOverview.Count de @Model.GroupsOverview.Count registros</div>
        <div style="overflow-x: auto;">
            <table class="data-table" id="tblGrupos">
                <thead><tr><th>Grupo</th><th>Carrera</th><th>Turno</th><th style="text-align:center;">Cuatrimestre</th><th style="text-align:center;">Estudiantes</th></tr></thead>
                <tbody>
                    @foreach (var g in Model.GroupsOverview)
                    {
                        var bc = g.StudentCount > 12 ? "badge-success" : g.StudentCount > 5 ? "badge-warning" : "badge-danger";
                        var cuatNum = new string(g.GroupCode.TakeWhile(char.IsDigit).ToArray());
                        <tr>
                            <td><span class="badge badge-accent" style="font-weight:700;">@g.GroupCode</span></td>
                            <td style="font-weight:500;color:var(--text-primary);">@g.CareerName</td>
                            <td>@g.Shift</td>
                            <td style="text-align:center;"><span class="badge badge-neutral">@cuatNum</span></td>
                            <td style="text-align:center;"><span class="badge @bc">@g.StudentCount</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Table 3: Estudiantes por Estatus -->
@if (Model.StudentsByStatus.Any())
{
    <div class="section-title">
        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
        Resumen por Estatus
    </div>
    <div class="chart-box" style="margin-bottom: 24px;">
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead><tr><th>Estatus</th><th style="text-align:center;">Total</th><th style="text-align:center;">Porcentaje</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.StudentsByStatus)
                    {
                        var sc = s.Status switch { "INSCRITO" => "badge-success", "PREINSCRITO" => "badge-warning", "BAJA" => "badge-danger", _ => "badge-accent" };
                        <tr>
                            <td style="font-weight:500;color:var(--text-primary);">@s.Status</td>
                            <td style="text-align:center;"><span class="badge @sc">@s.Count</span></td>
                            <td style="text-align:center;"><span class="badge badge-neutral">@s.Percentage%</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Table 4: Preinscripciones por Carrera -->
@if (Model.PreinscripcionesByCareer.Any())
{
    <div class="section-title">
        <svg viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" /></svg>
        Preinscripciones por Carrera
    </div>
    <div class="chart-box" style="margin-bottom: 24px;">
        <div style="display: flex; justify-content: flex-end; margin-bottom: 10px;">
            <button class="btn-export" onclick="exportTableToCSV('tblPreCarreras', 'preinscripciones_carrera.csv')"><svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg> Exportar a Excel</button>
        </div>
        <div style="overflow-x: auto;">
            <table class="data-table" id="tblPreCarreras">
                <thead><tr><th>Carrera</th><th style="text-align:center;">Total</th><th style="text-align:center;">%</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.PreinscripcionesByCareer)
                    {
                        <tr>
                            <td style="font-weight:500;color:var(--text-primary);">@c.CareerName</td>
                            <td style="text-align:center;"><span class="badge badge-accent">@c.Count</span></td>
                            <td style="text-align:center;"><span class="badge badge-neutral">@c.Percentage%</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Table 5: Historial de Cambios de Carrera -->
@if (Model.CareerChanges.Any())
{
    <div class="section-title">
        <svg viewBox="0 0 24 24"><polyline points="16 3 21 3 21 8" /><line x1="4" y1="20" x2="21" y2="3" /><polyline points="21 16 21 21 16 21" /><line x1="15" y1="15" x2="21" y2="21" /></svg>
        Historial de Cambios de Carrera
    </div>
    <div class="chart-box" style="margin-bottom: 24px;">
        <div style="display:flex;justify-content:flex-end;margin-bottom:10px;">
            <button class="btn-export" onclick="exportTableToCSV('tblCareerHistory','historial_cambio_carrera.csv')"><svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg> Exportar</button>
        </div>
        <div style="overflow-x:auto;">
            <table class="data-table" id="tblCareerHistory">
                <thead><tr><th>Alumno</th><th>Matrícula</th><th>Carrera</th><th style="text-align:center;">Inicio</th><th style="text-align:center;">Fin</th><th>Motivo</th></tr></thead>
                <tbody>
                    @foreach (var h in Model.CareerChanges)
                    {
                        <tr>
                            <td style="font-weight:500;color:var(--text-primary);">@h.StudentName</td>
                            <td style="font-size:12px;color:var(--text-muted);">@h.Matricula</td>
                            <td><span class="badge badge-accent">@h.CareerName</span></td>
                            <td style="text-align:center;font-size:12px;">@h.StartDate.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:center;font-size:12px;">@(h.EndDate.HasValue? h.EndDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td style="font-size:12px;color:var(--text-secondary);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@h.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Table 6: Historial de Cambios de Grupo -->
@if (Model.GroupChanges.Any())
{
    <div class="section-title">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
        Historial de Cambios de Grupo
    </div>
    <div class="chart-box" style="margin-bottom: 24px;">
        <div style="display:flex;justify-content:flex-end;margin-bottom:10px;">
            <button class="btn-export" onclick="exportTableToCSV('tblGroupHistory','historial_cambio_grupo.csv')"><svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg> Exportar</button>
        </div>
        <div style="overflow-x:auto;">
            <table class="data-table" id="tblGroupHistory">
                <thead><tr><th>Alumno</th><th>Matrícula</th><th>Grupo</th><th>Carrera</th><th style="text-align:center;">Inicio</th><th style="text-align:center;">Fin</th><th>Motivo</th></tr></thead>
                <tbody>
                    @foreach (var h in Model.GroupChanges)
                    {
                        <tr>
                            <td style="font-weight:500;color:var(--text-primary);">@h.StudentName</td>
                            <td style="font-size:12px;color:var(--text-muted);">@h.Matricula</td>
                            <td><span class="badge badge-info">@h.GroupCode</span></td>
                            <td>@h.CareerName</td>
                            <td style="text-align:center;font-size:12px;">@h.StartDate.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:center;font-size:12px;">@(h.EndDate.HasValue? h.EndDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td style="font-size:12px;color:var(--text-secondary);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@h.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <script>
        Chart.register(ChartDataLabels);
        Chart.defaults.color = '#8a9e95';
        Chart.defaults.borderColor = 'rgba(0,0,0,0.06)';
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
        Chart.defaults.font.size = 12;

        @if (Model.StudentsByCareers.Any())
        {
            <text>
            new Chart(document.getElementById('chartCareers'),{type:'bar',data:{labels:[@Html.Raw(string.Join(",", Model.StudentsByCareers.Select(c => $"'{c.CareerName}'")))],datasets:[{data:[@string.Join(",", Model.StudentsByCareers.Select(c => c.Count))],backgroundColor:'#22c3a6',borderRadius:4,borderSkipped:false,maxBarThickness:36}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},datalabels:{anchor:'end',align:'right',color:'#1a2b25',font:{weight:'700',size:13},offset:6}},scales:{x:{display:false,grid:{display:false}},y:{grid:{display:false}}},layout:{padding:{right:40}}}});
            </text>
        }

        @if (totalGender > 0)
        {
            <text>
            new Chart(document.getElementById('chartGender'),{type:'doughnut',data:{labels:['Masculino','Femenino'@(Model.OtherGenderCount > 0 ? ",'Otro'" : "")],datasets:[{data:[@Model.MaleCount,@Model.FemaleCount@(Model.OtherGenderCount > 0 ? $",{Model.OtherGenderCount}" : "")],backgroundColor:['#22c3a6','#f0b429'@(Model.OtherGenderCount > 0 ? ",'#c4c4c4'" : "")],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{position:'bottom',labels:{padding:20,usePointStyle:true,pointStyle:'rectRounded',font:{size:12}}},datalabels:{color:'#fff',font:{weight:'700',size:14},formatter:function(v,ctx){var t=ctx.dataset.data.reduce(function(a,b){return a+b},0);var p=t>0?Math.round(v/t*100):0;return p>5?p+'%':'';}}}}});
            </text>
        }

        function filterTableByColumn(value, tableId, colIndex) {
            var table = document.getElementById(tableId);
            if (!table) return;
            if (!window._filters) window._filters = {};
            if (!window._filters[tableId]) window._filters[tableId] = {};
            if (value) { window._filters[tableId][colIndex] = value; }
            else { delete window._filters[tableId][colIndex]; }
            var rows = table.querySelectorAll('tbody tr');
            var visible = 0;
            rows.forEach(function(row) {
                var show = true;
                for (var ci in window._filters[tableId]) {
                    var filterVal = window._filters[tableId][ci];
                    var cell = row.cells[parseInt(ci)];
                    if (cell && cell.textContent.trim().indexOf(filterVal) === -1) {
                        show = false;
                        break;
                    }
                }
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            var countEl = document.getElementById(tableId + 'Count');
            if (countEl) countEl.textContent = 'Mostrando 1 a ' + visible + ' de ' + rows.length + ' registros';
        }

        function exportTableToCSV(tid, fn) {
            var t = document.getElementById(tid);
            var r = t.querySelectorAll('tr');
            var c = [];
            r.forEach(function(row) {
                if (row.style.display === 'none') return;
                var cols = row.querySelectorAll('th,td');
                var d = [];
                cols.forEach(function(col) { d.push('"' + col.textContent.trim().replace(/\n/g, ' ').replace(/"/g, '""') + '"'); });
                c.push(d.join(','));
            });
            var b = new Blob(['\uFEFF' + c.join('\n')], { type: 'text/csv;charset=utf-8;' });
            var l = document.createElement('a');
            l.href = URL.createObjectURL(b);
            l.download = fn;
            l.click();
        }
    </script>
}