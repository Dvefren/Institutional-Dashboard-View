@model UTTN.Dashboard.ViewModels.Dashboard.AdmissionsViewModel
@{
    ViewData["Title"] = "Admisiones y Nuevo Ingreso";
    var totalGender = Model.MaleCount + Model.FemaleCount + Model.OtherGenderCount;
    var malePerc = totalGender > 0 ? Math.Round((decimal)Model.MaleCount / totalGender * 100, 1) : 0;
    var femalePerc = totalGender > 0 ? Math.Round((decimal)Model.FemaleCount / totalGender * 100, 1) : 0;
}

<style>
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }

    .kpi-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--shadow-sm);
    }

        .kpi-card .kpi-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .kpi-card .kpi-value {
            font-size: 32px;
            font-weight: 700;
            line-height: 1;
            letter-spacing: -0.02em;
        }

        .kpi-card .kpi-sub {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 6px;
        }

        .kpi-card .kpi-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .kpi-card .kpi-icon svg {
                width: 24px;
                height: 24px;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
                fill: none;
            }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text-primary);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-title svg {
            width: 20px;
            height: 20px;
            stroke: var(--accent);
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .chart-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }

    .chart-row-equal {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }

    .chart-box {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 22px;
        box-shadow: var(--shadow-sm);
    }

    .chart-box-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text-primary);
        margin-bottom: 18px;
    }

    .chart-container {
        position: relative;
        width: 100%;
        height: 300px;
    }

    .chart-container-donut {
        position: relative;
        width: 100%;
        height: 280px;
    }

    .status-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .status-pill {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 28px;
        text-align: center;
        box-shadow: var(--shadow-sm);
        min-width: 120px;
    }

        .status-pill .sp-value {
            font-size: 28px;
            font-weight: 700;
            line-height: 1;
        }

        .status-pill .sp-label {
            margin-top: 6px;
        }

        .status-pill .sp-perc {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 2px;
        }

    .filter-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        flex-wrap: wrap;
        gap: 10px;
    }

        .filter-row select {
            padding: 8px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            color: var(--text-primary);
            background: var(--bg-card);
            cursor: pointer;
            outline: none;
        }

        .filter-row .filter-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
        }

    .record-count {
        font-size: 12px;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    /* Progress bar for conversion */
    .progress-track {
        width: 100%;
        height: 10px;
        background: var(--bg-input);
        border-radius: 5px;
        overflow: hidden;
        margin-top: 8px;
    }

    .progress-fill {
        height: 100%;
        border-radius: 5px;
        transition: width 0.5s;
    }
</style>

@if (ViewBag.Error != null)
{
    <div style="background: var(--danger-light); border: 1px solid rgba(239,68,68,0.2); border-radius: var(--radius-sm); padding: 14px 16px; margin-bottom: 20px; color: var(--danger); font-size: 13px;">
        <strong>Error de conexión:</strong> @ViewBag.Error
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">Total Preinscripciones</div>
            <div class="kpi-value" style="color: var(--accent);">@Model.TotalPreinscripciones</div>
        </div>
        <div class="kpi-icon" style="background: var(--accent-light);">
            <svg viewBox="0 0 24 24" stroke="var(--accent)"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" /></svg>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">Inscritos Reales</div>
            <div class="kpi-value" style="color: var(--success);">@Model.TotalInscripciones</div>
        </div>
        <div class="kpi-icon" style="background: var(--success-light);">
            <svg viewBox="0 0 24 24" stroke="var(--success)"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">Promedio General</div>
            <div class="kpi-value" style="color: var(--purple);">@Model.PromedioGeneral</div>
        </div>
        <div class="kpi-icon" style="background: var(--purple-light);">
            <svg viewBox="0 0 24 24" stroke="var(--purple)"><path d="M12 20V10" /><path d="M18 20V4" /><path d="M6 20v-4" /></svg>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">Cumplimiento de Meta</div>
            <div class="kpi-value" style="color: var(--accent);">@Model.ConversionRate%</div>
            <div class="progress-track">
                <div class="progress-fill" style="width: @Model.ConversionRate%; background: var(--accent);"></div>
            </div>
        </div>
        <div class="kpi-icon" style="background: var(--accent-light);">
            <svg viewBox="0 0 24 24" stroke="var(--accent)"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
        </div>
    </div>
</div>

<!-- Embudo de Conversión (bar) + Inscritos por Carrera (donut) -->
<div class="chart-row">
    <div class="chart-box">
        <div class="chart-box-title">Embudo de Conversión (Drop-Off)</div>
        @if (Model.PreinscripcionesByStatus.Any())
        {
            <div class="chart-container"><canvas id="chartFunnel"></canvas></div>
        }
        else
        {
            <p class="no-data">Sin datos</p>
        }
    </div>
    <div class="chart-box">
        <div class="chart-box-title">Nuevos Inscritos por Carrera</div>
        @if (Model.PreinscripcionesByCareer.Any())
        {
            <div class="chart-container-donut"><canvas id="chartCareerDonut"></canvas></div>
        }
        else
        {
            <p class="no-data">Sin datos</p>
        }
    </div>
</div>

<!-- Promedio distribution + Medio difusion -->
<div class="chart-row-equal">
    <div class="chart-box">
        <div class="chart-box-title">Distribución de Promedios</div>
        @if (Model.PromedioDistribution.Any())
        {
            <div class="chart-container"><canvas id="chartPromedio"></canvas></div>
        }
        else
        {
            <p class="no-data">Sin datos</p>
        }
    </div>
    <div class="chart-box">
        <div class="chart-box-title">Medio de Difusión</div>
        @if (Model.ByMedioDifusion.Any())
        {
            <div class="chart-container-donut"><canvas id="chartMedio"></canvas></div>
        }
        else
        {
            <p class="no-data">Sin datos</p>
        }
    </div>
</div>

<!-- Geographic: Estado (bar) + Municipio (horizontal bar) -->
<div class="chart-row-equal">
    <div class="chart-box">
        <div class="chart-box-title">Origen por Estado</div>
        @if (Model.ByEstado.Any())
        {
            <div class="chart-container"><canvas id="chartEstado"></canvas></div>
        }
        else
        {
            <p class="no-data">Sin datos geográficos</p>
        }
    </div>
    <div class="chart-box">
        <div class="chart-box-title">Top 10 — Municipios</div>
        @if (Model.ByMunicipio.Any())
        {
            <div class="chart-container"><canvas id="chartMunicipio"></canvas></div>
        }
        else
        {
            <p class="no-data">Sin datos geográficos</p>
        }
    </div>
</div>

<!-- Gender + Monthly Trend -->
<div class="chart-row-equal">
    <div class="chart-box">
        <div class="chart-box-title">Género de Aspirantes</div>
        @if (totalGender > 0)
        {
            <div class="chart-container-donut"><canvas id="chartGender"></canvas></div>
        }
        else
        {
            <p class="no-data">Sin datos de género</p>
        }
    </div>
    <div class="chart-box">
        <div class="chart-box-title">Tendencia Mensual</div>
        @if (Model.MonthlyPreinscripciones.Any())
        {
            <div class="chart-container"><canvas id="chartMonthly"></canvas></div>
        }
        else
        {
            <p class="no-data">Sin datos</p>
        }
    </div>
</div>

<!-- Social indicators -->
<div class="section-title">
    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" /></svg>
    Indicadores Sociodemográficos
</div>
<div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 28px;">
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">Con Discapacidad</div>
            <div class="kpi-value" style="color: var(--purple);">@Model.ConDiscapacidad</div>
            <div class="kpi-sub">de @Model.TotalSaludRecords registros</div>
        </div>
        <div class="kpi-icon" style="background: var(--purple-light);">
            <svg viewBox="0 0 24 24" stroke="var(--purple)"><circle cx="12" cy="12" r="10" /><path d="M8 14s1.5 2 4 2 4-2 4-2" /><line x1="9" y1="9" x2="9.01" y2="9" /><line x1="15" y1="9" x2="15.01" y2="9" /></svg>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">Comunidad Indígena</div>
            <div class="kpi-value" style="color: var(--warning);">@Model.ComunidadIndigena</div>
        </div>
        <div class="kpi-icon" style="background: var(--warning-light);">
            <svg viewBox="0 0 24 24" stroke="var(--warning)"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 0 0 1 1h3m10-11l2 2m-2-2v10a1 1 0 0 1-1 1h-3m-4 0h4" /></svg>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">Con Hijos</div>
            <div class="kpi-value" style="color: var(--pink);">@Model.ConHijos</div>
        </div>
        <div class="kpi-icon" style="background: var(--pink-light);">
            <svg viewBox="0 0 24 24" stroke="var(--pink)"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        </div>
    </div>
</div>

<!-- Top Escuelas Table -->
@if (Model.TopEscuelas.Any())
{
    <div class="section-title">
        <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>
        Top 10 — Escuelas de Procedencia
    </div>
    <div class="chart-box" style="margin-bottom: 24px;">
        <div style="display: flex; justify-content: flex-end; margin-bottom: 10px;">
            <button class="btn-export" onclick="exportTableToCSV('tblEscuelas', 'top_escuelas_procedencia.csv')">
                <svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                Descargar Padrón de Aspirantes
            </button>
        </div>
        <div style="overflow-x: auto;">
            <table class="data-table" id="tblEscuelas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Escuela</th>
                        <th>Estado</th>
                        <th style="text-align: center;">Aspirantes</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rank = 1;
                    }
                    @foreach (var esc in Model.TopEscuelas)
                    {
                        <tr>
                            <td style="color: var(--text-muted); font-weight: 600;">@rank</td>
                            <td style="font-weight: 500; color: var(--text-primary);">@esc.EscuelaNombre</td>
                            <td>@esc.Estado</td>
                            <td style="text-align: center;"><span class="badge badge-accent">@esc.Count</span></td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Recent Preinscripciones -->
@if (Model.RecentPreinscripciones.Any())
{
    <div class="section-title">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
        Estado de Trámite de Aspirantes (Recientes)
    </div>
    <div class="chart-box">
        <div class="filter-row">
            <div style="display: flex; gap: 10px; align-items: center;">
                <span class="filter-label">Filtrar por estatus:</span>
                <select onchange="filterTableByColumn(this.value, 'tblRecent', 5)">
                    <option value="">Todos</option>
                    @foreach (var s in Model.PreinscripcionesByStatus)
                    {
                        <option value="@s.Status">@s.Status</option>
                    }
                </select>
            </div>
            <button class="btn-export" onclick="exportTableToCSV('tblRecent', 'aspirantes_recientes.csv')">
                <svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                Descargar Padrón de Aspirantes
            </button>
        </div>
        <div class="record-count" id="tblRecentCount">Mostrando 1 a @Model.RecentPreinscripciones.Count de @Model.RecentPreinscripciones.Count registros</div>
        <div style="overflow-x: auto;">
            <table class="data-table" id="tblRecent">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Nombre del Aspirante</th>
                        <th>Carrera Solicitada</th>
                        <th style="text-align: center;">Promedio</th>
                        <th>Preparatoria de Origen</th>
                        <th style="text-align: center;">Estatus</th>
                        <th style="text-align: right;">Fecha Registro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentPreinscripciones)
                    {
                        var statusClass = item.Estatus switch
                        {
                                        "Aceptado" or "Aceptada" => "badge-success",
                                        "Pendiente" => "badge-warning",
                                        "Inscrito" => "badge-accent",
                                        "Rechazado" or "Rechazada" => "badge-danger",
                            _ => "badge-info"
                        };
                        var promedioClass = item.Promedio >= 9 ? "badge-success" :
                        item.Promedio >= 8 ? "badge-accent" :
                        item.Promedio >= 7 ? "badge-warning" : "badge-danger";
                        <tr>
                            <td style="font-weight: 600; color: var(--accent);">@item.Folio</td>
                            <td style="font-weight: 500; color: var(--text-primary);">@item.Nombre</td>
                            <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Carrera</td>
                            <td style="text-align: center;"><span class="badge @promedioClass">@item.Promedio</span></td>
                            <td>@item.Estado</td>
                            <td style="text-align: center;"><span class="badge @statusClass">@item.Estatus</span></td>
                            <td style="text-align: right; font-size: 12px; color: var(--text-muted);">@item.Fecha.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <script>
        Chart.register(ChartDataLabels);
        Chart.defaults.color = '#8a9e95';
        Chart.defaults.borderColor = 'rgba(0,0,0,0.06)';
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
        Chart.defaults.font.size = 12;

        var dlBar = { anchor: 'end', align: 'top', color: '#1a2b25', font: { weight: '700', size: 13 }, offset: 2 };
        var dlBarH = { anchor: 'end', align: 'right', color: '#1a2b25', font: { weight: '700', size: 13 }, offset: 6 };
        var dlDonut = { color: '#fff', font: { weight: '700', size: 14 }, formatter: function(v,ctx) { var t=ctx.dataset.data.reduce(function(a,b){return a+b},0); var p=t>0?Math.round(v/t*100):0; return p>5?p+'%':''; } };
        var palette = ['#0d9e7a','#e84393','#f0b429','#22c3a6','#8b5cf6','#3b82f6','#ef4444','#06b6d4','#84cc16','#f97316'];

        // Funnel bar chart
        @if (Model.PreinscripcionesByStatus.Any())
        {
                <text>
                new Chart(document.getElementById('chartFunnel'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.PreinscripcionesByStatus.Select(s => $"'{s.Status}'")))],
                        datasets: [{
                            data: [@string.Join(",", Model.PreinscripcionesByStatus.Select(s => s.Count))],
                            backgroundColor: ['#22c3a6','#f0b429','#e84393','#ef4444','#8b5cf6','#3b82f6'],
                            borderRadius: 4, borderSkipped: false, maxBarThickness: 55
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false }, datalabels: dlBar },
                        scales: { x: { grid: { display: false }, ticks: { font: { size: 11 } } }, y: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { precision: 0 } } }
                    }
                });
                </text>
        }

        // Career donut
        @if (Model.PreinscripcionesByCareer.Any())
        {
                <text>
                new Chart(document.getElementById('chartCareerDonut'), {
                    type: 'doughnut',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.PreinscripcionesByCareer.Select(c => $"'{c.CareerName}'")))],
                        datasets: [{ data: [@string.Join(",", Model.PreinscripcionesByCareer.Select(c => c.Count))], backgroundColor: palette, borderWidth: 0 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '58%', plugins: { legend: { position: 'right', labels: { padding: 10, usePointStyle: true, pointStyle: 'rectRounded', font: { size: 11 } } }, datalabels: dlDonut } }
                });
                </text>
        }

        // Promedio bar
        @if (Model.PromedioDistribution.Any())
        {
                <text>
                new Chart(document.getElementById('chartPromedio'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.PromedioDistribution.Select(p => $"'{p.Range}'")))],
                        datasets: [{ data: [@string.Join(",", Model.PromedioDistribution.Select(p => p.Count))], backgroundColor: '#22c3a6', borderRadius: 4, borderSkipped: false, maxBarThickness: 50 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, datalabels: dlBar }, scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { precision: 0 } } } }
                });
                </text>
        }

        // Medio difusion donut
        @if (Model.ByMedioDifusion.Any())
        {
                <text>
                new Chart(document.getElementById('chartMedio'), {
                    type: 'doughnut',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.ByMedioDifusion.Select(m => $"'{m.Status}'")))],
                        datasets: [{ data: [@string.Join(",", Model.ByMedioDifusion.Select(m => m.Count))], backgroundColor: palette, borderWidth: 0 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '58%', plugins: { legend: { position: 'bottom', labels: { padding: 14, usePointStyle: true, pointStyle: 'rectRounded', font: { size: 11 } } }, datalabels: dlDonut } }
                });
                </text>
        }

        // Estado bar
        @if (Model.ByEstado.Any())
        {
                <text>
                new Chart(document.getElementById('chartEstado'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.ByEstado.Select(e => $"'{e.Name}'")))],
                        datasets: [{ data: [@string.Join(",", Model.ByEstado.Select(e => e.Count))], backgroundColor: '#22c3a6', borderRadius: 4, borderSkipped: false, maxBarThickness: 50 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, datalabels: dlBar }, scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { precision: 0 } } } }
                });
                </text>
        }

        // Municipio horizontal bar
        @if (Model.ByMunicipio.Any())
        {
                <text>
                new Chart(document.getElementById('chartMunicipio'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.ByMunicipio.Select(m => $"'{m.Name}'")))],
                        datasets: [{ data: [@string.Join(",", Model.ByMunicipio.Select(m => m.Count))], backgroundColor: '#e84393', borderRadius: 4, borderSkipped: false, maxBarThickness: 36 }]
                    },
                    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, datalabels: dlBarH }, scales: { x: { display: false, grid: { display: false } }, y: { grid: { display: false } } }, layout: { padding: { right: 40 } } }
                });
                </text>
        }

        // Gender donut
        @if (totalGender > 0)
        {
                <text>
                new Chart(document.getElementById('chartGender'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Masculino','Femenino'@(Model.OtherGenderCount > 0 ? ",'Otro'" : "")],
                        datasets: [{ data: [@Model.MaleCount,@Model.FemaleCount@(Model.OtherGenderCount > 0 ? $",{Model.OtherGenderCount}" : "")], backgroundColor: ['#22c3a6','#f0b429'@(Model.OtherGenderCount > 0 ? ",'#c4c4c4'" : "")], borderWidth: 0 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '62%', plugins: { legend: { position: 'bottom', labels: { padding: 20, usePointStyle: true, pointStyle: 'rectRounded', font: { size: 12 } } }, datalabels: dlDonut } }
                });
                </text>
        }

        // Monthly trend
        @if (Model.MonthlyPreinscripciones.Any())
        {
                <text>
                new Chart(document.getElementById('chartMonthly'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.MonthlyPreinscripciones.Select(m => $"'{m.Month} {m.Year}'")))],
                        datasets: [
                            { label: 'Preinscripciones', data: [@string.Join(",", Model.MonthlyPreinscripciones.Select(m => m.Count))], backgroundColor: '#22c3a6', borderRadius: 4, borderSkipped: false, maxBarThickness: 30 },
                            { label: 'Inscripciones', data: [@string.Join(",", Model.MonthlyInscripciones.Select(m => m.Count))], backgroundColor: '#e84393', borderRadius: 4, borderSkipped: false, maxBarThickness: 30 }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { labels: { usePointStyle: true, pointStyle: 'rectRounded', padding: 20 } }, datalabels: dlBar },
                        scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { precision: 0 } } }
                    }
                });
                </text>
        }

        function filterTableByColumn(value, tableId, colIndex) {
            var table = document.getElementById(tableId);
            var rows = table.querySelectorAll('tbody tr');
            var visible = 0;
            rows.forEach(function(row) {
                var cell = row.cells[colIndex];
                if (!value || (cell && cell.textContent.trim() === value)) { row.style.display = ''; visible++; }
                else { row.style.display = 'none'; }
            });
            var countEl = document.getElementById(tableId + 'Count');
            if (countEl) countEl.textContent = 'Mostrando 1 a ' + visible + ' de ' + rows.length + ' registros';
        }

        function exportTableToCSV(tableId, filename) {
            var table = document.getElementById(tableId);
            var rows = table.querySelectorAll('tr');
            var csv = [];
            rows.forEach(function(row) {
                if (row.style.display === 'none') return;
                var cols = row.querySelectorAll('th, td');
                var rowData = [];
                cols.forEach(function(col) { rowData.push('"' + col.textContent.trim().replace(/"/g, '""') + '"'); });
                csv.push(rowData.join(','));
            });
            var blob = new Blob(['\uFEFF' + csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = filename;
            link.click();
        }
    </script>
}