@model UTTN.Dashboard.ViewModels.Dashboard.AdmissionsViewModel
@{
    ViewData["Title"] = "Inscripciones — Embudo de Captación";
    var totalGender = Model.MaleCount + Model.FemaleCount + Model.OtherGenderCount;
    var malePerc = totalGender > 0 ? Math.Round((decimal)Model.MaleCount / totalGender * 100, 1) : 0;
    var femalePerc = totalGender > 0 ? Math.Round((decimal)Model.FemaleCount / totalGender * 100, 1) : 0;
}

<style>
    .chart-container {
        position: relative;
        width: 100%;
        height: 280px;
    }

    .chart-container-sm {
        position: relative;
        width: 200px;
        height: 200px;
    }

    .chart-container-lg {
        position: relative;
        width: 100%;
        height: 350px;
    }

    .badge-status {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
    }

    .funnel-step {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: rgba(255,255,255,0.02);
    }

        .funnel-step .step-number {
            font-size: 32px;
            font-weight: 700;
            min-width: 80px;
        }

        .funnel-step .step-label {
            font-size: 13px;
            color: var(--text-secondary);
        }

    .funnel-arrow {
        text-align: center;
        color: var(--text-muted);
        font-size: 20px;
        padding: 4px 0;
    }

    .indicator-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 20px;
        text-align: center;
    }

        .indicator-card .ic-value {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .indicator-card .ic-label {
            font-size: 12px;
            color: var(--text-muted);
        }

        .indicator-card .ic-sub {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 2px;
        }
</style>

@if (ViewBag.Error != null)
{
    <div style="background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.3); border-radius: 8px; padding: 16px; margin-bottom: 24px; color: var(--danger); font-size: 13px;">
        <strong>Error de conexión:</strong> @ViewBag.Error
    </div>
}

<div style="margin-bottom: 32px;">
    <p style="color: var(--text-secondary); font-size: 14px;">
        Seguimiento del proceso de captación: preinscripción, inscripción y conversión.
    </p>
</div>

<!-- Funnel KPIs -->
<div style="display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 12px; align-items: center; margin-bottom: 24px;">
    <div class="funnel-step" style="border-left: 3px solid var(--accent);">
        <div>
            <div class="step-number" style="color: var(--accent);">@Model.TotalPreinscripciones</div>
            <div class="step-label">Preinscripciones</div>
        </div>
    </div>
    <div class="funnel-arrow">→</div>
    <div class="funnel-step" style="border-left: 3px solid var(--success);">
        <div>
            <div class="step-number" style="color: var(--success);">@Model.TotalInscripciones</div>
            <div class="step-label">Inscripciones</div>
        </div>
    </div>
    <div class="funnel-arrow">→</div>
    <div class="funnel-step" style="border-left: 3px solid #a78bfa;">
        <div>
            <div class="step-number" style="color: #a78bfa;">@Model.ConversionRate%</div>
            <div class="step-label">Tasa de conversión</div>
        </div>
    </div>
</div>

<!-- Stats Row -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
    <div class="stat-card" style="border-left: 3px solid var(--accent);">
        <div class="label">Promedio general</div>
        <div class="value" style="color: var(--accent); font-size: 24px;">@Model.PromedioGeneral</div>
    </div>
    <div class="stat-card" style="border-left: 3px solid #a78bfa;">
        <div class="label">Con discapacidad</div>
        <div class="value" style="color: #a78bfa; font-size: 24px;">@Model.ConDiscapacidad</div>
        <div style="font-size: 11px; color: var(--text-muted);">de @Model.TotalSaludRecords registros</div>
    </div>
    <div class="stat-card" style="border-left: 3px solid var(--warning);">
        <div class="label">Comunidad indígena</div>
        <div class="value" style="color: var(--warning); font-size: 24px;">@Model.ComunidadIndigena</div>
    </div>
    <div class="stat-card" style="border-left: 3px solid #f472b6;">
        <div class="label">Con hijos</div>
        <div class="value" style="color: #f472b6; font-size: 24px;">@Model.ConHijos</div>
    </div>
</div>

<!-- Charts Row 1: Career + Gender -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
    <div class="card">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 16px;">Preinscripciones por Carrera</div>
        @if (Model.PreinscripcionesByCareer.Any())
        {
            <div class="chart-container">
                <canvas id="chartCareer"></canvas>
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 40px 0;">Sin datos</p>
        }
    </div>

    <div class="card">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 16px;">Género de Aspirantes</div>
        @if (totalGender > 0)
        {
            <div style="display: flex; align-items: center; gap: 32px;">
                <div class="chart-container-sm">
                    <canvas id="chartGender"></canvas>
                </div>
                <div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <span style="width: 12px; height: 12px; border-radius: 3px; background: #4f6ef7; display: inline-block;"></span>
                        <span style="font-size: 13px; color: var(--text-secondary);">Masculino — @Model.MaleCount (@malePerc%)</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <span style="width: 12px; height: 12px; border-radius: 3px; background: #a78bfa; display: inline-block;"></span>
                        <span style="font-size: 13px; color: var(--text-secondary);">Femenino — @Model.FemaleCount (@femalePerc%)</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 40px 0;">Sin datos de género</p>
        }
    </div>
</div>

<!-- Charts Row 2: Promedio + Medio Difusion -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
    <div class="card">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 16px;">Distribución de Promedios</div>
        @if (Model.PromedioDistribution.Any())
        {
            <div class="chart-container">
                <canvas id="chartPromedio"></canvas>
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 40px 0;">Sin datos</p>
        }
    </div>

    <div class="card">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 16px;">Medio de Difusión</div>
        @if (Model.ByMedioDifusion.Any())
        {
            <div class="chart-container">
                <canvas id="chartMedio"></canvas>
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 40px 0;">Sin datos</p>
        }
    </div>
</div>

<!-- Charts Row 3: Geographic -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
    <div class="card">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 16px;">Origen por Estado</div>
        @if (Model.ByEstado.Any())
        {
            <div class="chart-container">
                <canvas id="chartEstado"></canvas>
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 40px 0;">Sin datos geográficos</p>
        }
    </div>

    <div class="card">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 16px;">Top 10 — Municipios</div>
        @if (Model.ByMunicipio.Any())
        {
            <div class="chart-container">
                <canvas id="chartMunicipio"></canvas>
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 40px 0;">Sin datos geográficos</p>
        }
    </div>
</div>

<!-- Monthly Trend -->
<div class="card" style="margin-bottom: 24px;">
    <div style="font-size: 14px; font-weight: 600; margin-bottom: 16px;">Tendencia Mensual — Preinscripciones vs Inscripciones</div>
    @if (Model.MonthlyPreinscripciones.Any())
    {
        <div class="chart-container">
            <canvas id="chartMonthly"></canvas>
        </div>
    }
    else
    {
        <p style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 40px 0;">Sin datos de tendencia</p>
    }
</div>

<!-- Top Escuelas Table -->
@if (Model.TopEscuelas.Any())
{
    <div class="card" style="margin-bottom: 24px;">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 16px;">Top 10 — Escuelas de Procedencia</div>
        <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border);">
                    <th style="text-align: left; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">#</th>
                    <th style="text-align: left; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Escuela</th>
                    <th style="text-align: left; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Estado</th>
                    <th style="text-align: right; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Aspirantes</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rank = 1;
                }
                @foreach (var esc in Model.TopEscuelas)
                {
                    <tr style="border-bottom: 1px solid var(--border);">
                        <td style="padding: 12px; color: var(--text-muted);">@rank</td>
                        <td style="padding: 12px;">@esc.EscuelaNombre</td>
                        <td style="padding: 12px; color: var(--text-secondary);">@esc.Estado</td>
                        <td style="padding: 12px; text-align: right;">
                            <span style="background: var(--accent-glow); color: var(--accent); padding: 4px 12px; border-radius: 6px; font-weight: 600; font-size: 12px;">@esc.Count</span>
                        </td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
}

<!-- Recent Preinscripciones Table -->
@if (Model.RecentPreinscripciones.Any())
{
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <div style="font-size: 14px; font-weight: 600;">Últimas Preinscripciones</div>
            <div style="font-size: 12px; color: var(--text-muted);">Últimos 50 registros</div>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border);">
                        <th style="text-align: left; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Folio</th>
                        <th style="text-align: left; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Nombre</th>
                        <th style="text-align: left; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Carrera</th>
                        <th style="text-align: center; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Promedio</th>
                        <th style="text-align: left; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Estado</th>
                        <th style="text-align: center; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Estatus</th>
                        <th style="text-align: right; padding: 10px 12px; color: var(--text-muted); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentPreinscripciones)
                    {
                        var statusColor = item.Estatus switch
                        {
                                        "Aceptado" or "Aceptada" => "background: rgba(52,211,153,0.1); color: var(--success);",
                                        "Pendiente" => "background: rgba(251,191,36,0.1); color: var(--warning);",
                                        "Rechazado" or "Rechazada" => "background: rgba(248,113,113,0.1); color: var(--danger);",
                            _ => "background: rgba(79,110,247,0.1); color: var(--accent);"
                        };
                        var promedioColor = item.Promedio >= 9 ? "var(--success)" :
                        item.Promedio >= 8 ? "var(--accent)" :
                        item.Promedio >= 7 ? "var(--warning)" : "var(--danger)";
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                            <td style="padding: 12px;">
                                <span style="font-family: monospace; font-size: 12px; color: var(--text-muted);">@item.Folio</span>
                            </td>
                            <td style="padding: 12px;">@item.Nombre</td>
                            <td style="padding: 12px; color: var(--text-secondary); max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Carrera</td>
                            <td style="padding: 12px; text-align: center;">
                                <span style="color: @promedioColor; font-weight: 600;">@item.Promedio</span>
                            </td>
                            <td style="padding: 12px; color: var(--text-secondary);">@item.Estado</td>
                            <td style="padding: 12px; text-align: center;">
                                <span class="badge-status" style="@statusColor">@item.Estatus</span>
                            </td>
                            <td style="padding: 12px; text-align: right; color: var(--text-muted); font-size: 12px;">@item.Fecha.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.color = '#8888a0';
        Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
        Chart.defaults.font.size = 12;
        var palette = ['#4f6ef7','#34d399','#a78bfa','#fbbf24','#f87171','#38bdf8','#fb923c','#e879f9','#818cf8','#6ee7b7'];

        @if (Model.PreinscripcionesByCareer.Any())
        {
                <text>
                new Chart(document.getElementById('chartCareer'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.PreinscripcionesByCareer.Select(c => $"'{c.CareerName}'")))],
                        datasets: [{ data: [@string.Join(",", Model.PreinscripcionesByCareer.Select(c => c.Count))], backgroundColor: palette, borderRadius: 6, borderSkipped: false, maxBarThickness: 40 }]
                    },
                    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false }, ticks: { precision: 0 } }, y: { grid: { display: false } } } }
                });
                </text>
        }

        @if (totalGender > 0)
        {
                <text>
                new Chart(document.getElementById('chartGender'), {
                    type: 'doughnut',
                    data: { labels: ['Masculino','Femenino'], datasets: [{ data: [@Model.MaleCount, @Model.FemaleCount], backgroundColor: ['#4f6ef7','#a78bfa'], borderWidth: 0 }] },
                    options: { responsive: true, maintainAspectRatio: true, cutout: '65%', plugins: { legend: { display: false } } }
                });
                </text>
        }

        @if (Model.PromedioDistribution.Any())
        {
                <text>
                new Chart(document.getElementById('chartPromedio'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.PromedioDistribution.Select(p => $"'{p.Range}'")))],
                        datasets: [{ data: [@string.Join(",", Model.PromedioDistribution.Select(p => p.Count))], backgroundColor: ['#34d399','#4f6ef7','#fbbf24','#fb923c','#f87171'], borderRadius: 6, borderSkipped: false, maxBarThickness: 50 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { grid: { display: false }, ticks: { precision: 0 } } } }
                });
                </text>
        }

        @if (Model.ByMedioDifusion.Any())
        {
                <text>
                new Chart(document.getElementById('chartMedio'), {
                    type: 'doughnut',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.ByMedioDifusion.Select(m => $"'{m.Status}'")))],
                        datasets: [{ data: [@string.Join(",", Model.ByMedioDifusion.Select(m => m.Count))], backgroundColor: palette, borderWidth: 0 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '55%', plugins: { legend: { position: 'right', labels: { padding: 12, usePointStyle: true, pointStyle: 'rectRounded' } } } }
                });
                </text>
        }

        @if (Model.ByEstado.Any())
        {
                <text>
                new Chart(document.getElementById('chartEstado'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.ByEstado.Select(e => $"'{e.Name}'")))],
                        datasets: [{ data: [@string.Join(",", Model.ByEstado.Select(e => e.Count))], backgroundColor: '#4f6ef7', borderRadius: 6, borderSkipped: false, maxBarThickness: 50 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { grid: { display: false }, ticks: { precision: 0 } } } }
                });
                </text>
        }

        @if (Model.ByMunicipio.Any())
        {
                <text>
                new Chart(document.getElementById('chartMunicipio'), {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.ByMunicipio.Select(m => $"'{m.Name}'")))],
                        datasets: [{ data: [@string.Join(",", Model.ByMunicipio.Select(m => m.Count))], backgroundColor: '#34d399', borderRadius: 6, borderSkipped: false, maxBarThickness: 40 }]
                    },
                    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false }, ticks: { precision: 0 } }, y: { grid: { display: false } } } }
                });
                </text>
        }

        @if (Model.MonthlyPreinscripciones.Any())
        {
                <text>
                new Chart(document.getElementById('chartMonthly'), {
                    type: 'line',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.MonthlyPreinscripciones.Select(m => $"'{m.Month} {m.Year}'")))],
                        datasets: [
                            { label: 'Preinscripciones', data: [@string.Join(",", Model.MonthlyPreinscripciones.Select(m => m.Count))], borderColor: '#4f6ef7', backgroundColor: 'rgba(79,110,247,0.1)', fill: true, tension: 0.4, pointRadius: 4, borderWidth: 2 },
                            { label: 'Inscripciones', data: [@string.Join(",", Model.MonthlyInscripciones.Select(m => m.Count))], borderColor: '#34d399', backgroundColor: 'rgba(52,211,153,0.1)', fill: true, tension: 0.4, pointRadius: 4, borderWidth: 2 }
                        ]
                    },
                        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { usePointStyle: true, pointStyle: 'circle', padding: 20 } } }, scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { precision: 0 } } } }
                });
                </text>
        }
    </script>
}