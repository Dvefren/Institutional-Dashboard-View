@model UTTN.Dashboard.ViewModels.Dashboard.TramitesViewModel
@{
    ViewData["Title"] = "Control de Trámites y Ventanilla";
    var totalDocs = Model.DocsAprobados + Model.DocsPendientes + Model.DocsRechazados;
    var cuatNames = new Dictionary<int, string> { { 0, "Todo el año" }, { 1, "Ene — Abr" }, { 2, "May — Ago" }, { 3, "Sep — Dic" } };
}

<style>
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .kpi-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--shadow-sm);
    }

        .kpi-card .kpi-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .kpi-card .kpi-value {
            font-size: 30px;
            font-weight: 700;
            line-height: 1;
        }

        .kpi-card .kpi-sub {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .kpi-card .kpi-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .kpi-card .kpi-icon svg {
                width: 22px;
                height: 22px;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
                fill: none;
            }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text-primary);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-title svg {
            width: 20px;
            height: 20px;
            stroke: var(--accent);
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .chart-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }

    .chart-box {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }

    .chart-box-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text-primary);
        margin-bottom: 16px;
    }

    .chart-container {
        position: relative;
        width: 100%;
        height: 280px;
    }

    .chart-container-donut {
        position: relative;
        width: 100%;
        height: 260px;
    }

    .filter-bar {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        box-shadow: var(--shadow-sm);
    }

        .filter-bar label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .filter-bar select {
            padding: 8px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            color: var(--text-primary);
            background: white;
            cursor: pointer;
            outline: none;
        }

        .filter-bar .btn-apply {
            padding: 8px 20px;
            background: var(--accent);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .filter-bar .btn-clear {
            padding: 8px 16px;
            background: var(--bg-input);
            color: var(--text-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            cursor: pointer;
        }

    .active-filter {
        background: var(--accent-light);
        border: 1px solid var(--accent);
        border-radius: var(--radius-sm);
        padding: 8px 16px;
        font-size: 12px;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 16px;
        display: inline-block;
    }

    .filter-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        flex-wrap: wrap;
        gap: 10px;
    }

        .filter-row select {
            padding: 7px 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 13px;
            color: var(--text-primary);
            background: white;
            cursor: pointer;
            outline: none;
        }

    .record-count {
        font-size: 12px;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .tipo-bar {
        height: 10px;
        border-radius: 5px;
        display: flex;
        overflow: hidden;
        background: var(--bg-input);
    }

    .tipo-bar-seg {
        height: 100%;
    }
</style>

@if (ViewBag.Error != null)
{
    <div style="background: var(--danger-light); border: 1px solid rgba(239,68,68,0.2); border-radius: var(--radius-sm); padding: 14px 16px; margin-bottom: 20px; color: var(--danger); font-size: 13px;"><strong>Error:</strong> @ViewBag.Error</div>
}

<!-- Period Filter -->
<form method="get" class="filter-bar">
    <label>Año:</label>
    <select name="year">@foreach (var y in Model.AvailableYears) { if (y == Model.SelectedYear) {
    <option value="@y" selected="selected">@y</option>
        } else
    {

        <option value="@y">@y</option>
    } }
</select>
    <label>Cuatrimestre:</label>
    <select name="cuatrimestre">@{
        var cuatOptions = new Dictionary<int, string> { { 0, "Todo el año" }, { 1, "Ene — Abr" }, { 2, "May — Ago" }, { 3, "Sep — Dic" } };
        }
 @foreach (var opt in cuatOptions)
{
    if (opt.Key == Model.SelectedCuatrimestre)
    {
            <option value="@opt.Key" selected="selected">@opt.Value</option>
        }
        else
        {

            <option value="@opt.Key">@opt.Value</option>
        }
    }
</select>
    <button type="submit" class="btn-apply">Aplicar</button>
    <a href="@Url.Action("Index", "Tramites")" class="btn-clear">Limpiar</a>
</form>
@if (Model.SelectedCuatrimestre > 0)
{
    <div class="active-filter">Filtro activo: Año @Model.SelectedYear, @cuatNames[Model.SelectedCuatrimestre]</div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card"><div><div class="kpi-label">Total Solicitudes</div><div class="kpi-value" style="color:var(--accent);">@Model.TotalSolicitudes</div></div><div class="kpi-icon" style="background:var(--accent-light);"><svg viewBox="0 0 24 24" stroke="var(--accent)"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></div></div>
    <div class="kpi-card"><div><div class="kpi-label">Pendientes</div><div class="kpi-value" style="color:var(--warning);">@Model.Pendientes</div></div><div class="kpi-icon" style="background:var(--warning-light);"><svg viewBox="0 0 24 24" stroke="var(--warning)"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg></div></div>
    <div class="kpi-card"><div><div class="kpi-label">Tiempo Promedio</div><div class="kpi-value" style="color:var(--purple);">@Model.PromedioResolucionDias</div><div class="kpi-sub">Días</div></div><div class="kpi-icon" style="background:var(--purple-light);"><svg viewBox="0 0 24 24" stroke="var(--purple)"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg></div></div>
    <div class="kpi-card"><div><div class="kpi-label">Tasa Completado</div><div class="kpi-value" style="color:var(--success);">@Model.TasaCompletado%</div><div style="width:100%;height:8px;background:var(--bg-input);border-radius:4px;overflow:hidden;margin-top:6px;"><div style="height:100%;width:@Model.TasaCompletado%;background:var(--success);border-radius:4px;"></div></div></div><div class="kpi-icon" style="background:var(--success-light);"><svg viewBox="0 0 24 24" stroke="var(--success)"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg></div></div>
</div>

<!-- 2 Charts: Volume by type (bar) + Semáforo (donut) -->
<div class="chart-row">
    <div class="chart-box">
        <div class="chart-box-title">Volumen por Tipo de Trámite</div>
        @if (Model.ByTipoTramite.Any())
        {
            <div class="chart-container"><canvas id="chartVolume"></canvas></div>
        }
        else
        {

            <p class="no-data">Sin datos para este periodo</p>
        }
    </div>
    <div class="chart-box">
        <div class="chart-box-title">Semáforo de Entregas</div>
        @if (Model.ByStatus.Any())
        {
            <div class="chart-container-donut"><canvas id="chartSemaforo"></canvas></div>
        }
        else
        {

            <p class="no-data">Sin datos</p>
        }
    </div>
</div>

<!-- Table 1: Desglose por Tipo -->
@if (Model.ByTipoTramite.Any())
{
    <div class="section-title"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg> Desglose por Tipo de Trámite</div>
    <div class="chart-box" style="margin-bottom:24px;">
        <div style="overflow-x:auto;">
            <table class="data-table" id="tblTipos">
                <thead><tr><th>Tipo de Trámite</th><th style="text-align:center;">Total</th><th style="text-align:center;">Completadas</th><th style="text-align:center;">Pendientes</th><th style="text-align:center;">Rechazadas</th><th style="width:200px;">Progreso</th></tr></thead>
                <tbody>
                    @foreach (var tipo in Model.ByTipoTramite)
                    {
                        var pComp = tipo.Total > 0 ? Math.Round((decimal)tipo.Completadas / tipo.Total * 100, 0) : 0;
                        var pPend = tipo.Total > 0 ? Math.Round((decimal)tipo.Pendientes / tipo.Total * 100, 0) : 0;
                        var pRech = tipo.Total > 0 ? Math.Round((decimal)tipo.Rechazadas / tipo.Total * 100, 0) : 0;
                        <tr>
                            <td style="font-weight:500;color:var(--text-primary);">@tipo.TipoNombre</td>
                            <td style="text-align:center;"><span class="badge badge-accent">@tipo.Total</span></td>
                            <td style="text-align:center;"><span class="badge badge-success">@tipo.Completadas</span></td>
                            <td style="text-align:center;"><span class="badge badge-warning">@tipo.Pendientes</span></td>
                            <td style="text-align:center;"><span class="badge @(tipo.Rechazadas > 0 ? "badge-danger" : "badge-neutral")">@tipo.Rechazadas</span></td>
                            <td><div class="tipo-bar"><div class="tipo-bar-seg" style="width:@(pComp)%;background:var(--success);"></div><div class="tipo-bar-seg" style="width:@(pPend)%;background:var(--warning);"></div><div class="tipo-bar-seg" style="width:@(pRech)%;background:var(--danger);"></div></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Table 2: Documentos -->
@if (totalDocs > 0)
{
    <div class="section-title"><svg viewBox="0 0 24 24"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="13 2 13 9 20 9" /></svg> Validación de Documentos</div>
    <div class="chart-box" style="margin-bottom:24px;">
        <div style="overflow-x:auto;">
            <table class="data-table">
                <thead><tr><th>Estatus</th><th style="text-align:center;">Total</th><th style="text-align:center;">%</th></tr></thead>
                <tbody>
                    <tr><td style="font-weight:500;color:var(--success);">Aprobados</td><td style="text-align:center;"><span class="badge badge-success">@Model.DocsAprobados</span></td><td style="text-align:center;"><span class="badge badge-neutral">@(totalDocs > 0 ? Math.Round((decimal)Model.DocsAprobados / totalDocs * 100, 1) : 0)%</span></td></tr>
                    <tr><td style="font-weight:500;color:var(--warning);">Pendientes</td><td style="text-align:center;"><span class="badge badge-warning">@Model.DocsPendientes</span></td><td style="text-align:center;"><span class="badge badge-neutral">@(totalDocs > 0 ? Math.Round((decimal)Model.DocsPendientes / totalDocs * 100, 1) : 0)%</span></td></tr>
                    <tr><td style="font-weight:500;color:var(--danger);">Rechazados</td><td style="text-align:center;"><span class="badge badge-danger">@Model.DocsRechazados</span></td><td style="text-align:center;"><span class="badge badge-neutral">@(totalDocs > 0 ? Math.Round((decimal)Model.DocsRechazados / totalDocs * 100, 1) : 0)%</span></td></tr>
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Table 3: Alerta — Antigüedad -->
@if (Model.OldestPending.Any())
{
    <div class="section-title"><svg viewBox="0 0 24 24" style="stroke:var(--danger);"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg> <span style="color:var(--danger);">Solicitudes con Mayor Antigüedad</span></div>
    <div class="chart-box" style="margin-bottom:24px;border-left:3px solid var(--danger);">
        <div style="overflow-x:auto;">
            <table class="data-table">
                <thead><tr><th>Folio</th><th>Alumno</th><th>Trámite</th><th>Fecha</th><th style="text-align:center;">Estatus</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.OldestPending)
                    {
                        var uc = item.DiasTranscurridos > 30 ? "badge-danger" : item.DiasTranscurridos > 15 ? "badge-warning" : "badge-success";
                        var ul = item.DiasTranscurridos > 30 ? "Retrasado" : item.DiasTranscurridos > 15 ? "Por Vencer" : "A Tiempo";
                        <tr><td style="font-weight:600;color:var(--accent);">TRM-@item.Id</td><td style="font-weight:500;color:var(--text-primary);">@item.Nombre</td><td>@item.TipoTramite</td><td style="font-size:12px;color:var(--text-muted);">@item.Fecha.ToString("dd/MM/yyyy")</td><td style="text-align:center;"><span class="badge @uc">@ul (@item.DiasTranscurridos días)</span></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Table 4: Bandeja de Solicitudes -->
@if (Model.RecentSolicitudes.Any())
{
    <div class="section-title"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18" /><path d="M9 21V9" /></svg> Bandeja de Solicitudes Recientes</div>
    <div class="chart-box">
        <div class="filter-row">
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                <label style="font-size:13px;font-weight:600;color:var(--text-secondary);">Estatus:</label>
                <select onchange="filterTableByColumn(this.value,'tblSolicitudes',4)">
                    <option value="">Todos</option>
                    @foreach (var s in Model.ByStatus)
                    {
                        <option value="@s.Status">@s.Status</option>
                    }
                </select>
                <label style="font-size:13px;font-weight:600;color:var(--text-secondary);margin-left:8px;">Trámite:</label>
                <select onchange="filterTableByColumn(this.value,'tblSolicitudes',3)">
                    <option value="">Todos</option>
                    @foreach (var t in Model.ByTipoTramite)
                    {
                        <option value="@t.TipoNombre">@t.TipoNombre</option>
                    }
                </select>
            </div>
            <button class="btn-export" onclick="exportTableToCSV('tblSolicitudes','reporte_tramites.csv')"><svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg> Exportar</button>
        </div>
        <div class="record-count" id="tblSolicitudesCount">Mostrando 1 a @Model.RecentSolicitudes.Count de @Model.RecentSolicitudes.Count registros</div>
        <div style="overflow-x:auto;">
            <table class="data-table" id="tblSolicitudes">
                <thead><tr><th>Folio</th><th>Alumno</th><th>Matrícula</th><th>Trámite</th><th style="text-align:center;">Estatus</th><th style="text-align:right;">Fecha</th><th style="text-align:right;">Días</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.RecentSolicitudes)
                    {
                        var sc = item.Estatus switch { "Completado" or "Aprobado" => "badge-success", "Pendiente" => "badge-warning", "En Revisión" => "badge-info", "Rechazado" => "badge-danger", _ => "badge-accent" };
                        <tr>
                            <td style="font-weight:600;color:var(--accent);">TRM-@item.Id</td>
                            <td style="font-weight:500;color:var(--text-primary);">@item.Nombre</td>
                            <td style="font-size:12px;color:var(--text-muted);">@item.Matricula</td>
                            <td>@item.TipoTramite</td>
                            <td style="text-align:center;"><span class="badge @sc">@item.Estatus</span></td>
                            <td style="text-align:right;font-size:12px;color:var(--text-muted);">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:right;font-weight:600;font-size:12px;">@item.DiasTranscurridos</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <script>
        Chart.register(ChartDataLabels);
        Chart.defaults.color = '#8a9e95'; Chart.defaults.borderColor = 'rgba(0,0,0,0.06)'; Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif"; Chart.defaults.font.size = 12;
        var dlBar = { anchor:'end', align:'top', color:'#1a2b25', font:{weight:'700',size:13}, offset:2 };
        var dlDonut = { color:'#fff', font:{weight:'700',size:14}, formatter:function(v,ctx){var t=ctx.dataset.data.reduce(function(a,b){return a+b},0);var p=t>0?Math.round(v/t*100):0;return p>5?p+'%':'';} };

        @if (Model.ByTipoTramite.Any())
        {
            <text>
            new Chart(document.getElementById('chartVolume'),{type:'bar',data:{labels:[@Html.Raw(string.Join(",", Model.ByTipoTramite.Select(t => $"'{t.TipoNombre}'")))],datasets:[{data:[@string.Join(",", Model.ByTipoTramite.Select(t => t.Total))],backgroundColor:'#22c3a6',borderRadius:4,borderSkipped:false,maxBarThickness:50}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},datalabels:dlBar},scales:{x:{grid:{display:false},ticks:{font:{size:11},maxRotation:45}},y:{grid:{color:'rgba(0,0,0,0.06)'},ticks:{precision:0}}}}});
            </text>
        }

        @if (Model.ByStatus.Any())
        {
            <text>
            new Chart(document.getElementById('chartSemaforo'),{type:'doughnut',data:{labels:[@Html.Raw(string.Join(",", Model.ByStatus.Select(s => $"'{s.Status}'")))],datasets:[{data:[@string.Join(",", Model.ByStatus.Select(s => s.Count))],backgroundColor:['#10b981','#f59e0b','#3b82f6','#ef4444','#8b5cf6'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{position:'bottom',labels:{padding:14,usePointStyle:true,pointStyle:'rectRounded',font:{size:11}}},datalabels:dlDonut}}});
            </text>
        }

        function filterTableByColumn(value,tableId,colIndex){var table=document.getElementById(tableId);if(!table)return;if(!window._filters)window._filters={};if(!window._filters[tableId])window._filters[tableId]={};if(value){window._filters[tableId][colIndex]=value;}else{delete window._filters[tableId][colIndex];}var rows=table.querySelectorAll('tbody tr');var visible=0;rows.forEach(function(row){var show=true;for(var ci in window._filters[tableId]){var fv=window._filters[tableId][ci];var cell=row.cells[parseInt(ci)];if(cell&&cell.textContent.trim().indexOf(fv)===-1){show=false;break;}}row.style.display=show?'':'none';if(show)visible++;});var el=document.getElementById(tableId+'Count');if(el)el.textContent='Mostrando 1 a '+visible+' de '+rows.length+' registros';}
        function exportTableToCSV(tid,fn){var t=document.getElementById(tid);var r=t.querySelectorAll('tr');var c=[];r.forEach(function(row){if(row.style.display==='none')return;var cols=row.querySelectorAll('th,td');var d=[];cols.forEach(function(col){d.push('"'+col.textContent.trim().replace(/\n/g,' ').replace(/"/g,'""')+'"');});c.push(d.join(','));});var b=new Blob(['\uFEFF'+c.join('\n')],{type:'text/csv;charset=utf-8;'});var l=document.createElement('a');l.href=URL.createObjectURL(b);l.download=fn;l.click();}
    </script>
}
