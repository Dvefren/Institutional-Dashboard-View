@model Dictionary<string, object>
@{
    ViewData["Title"] = "Diagnóstico de Base de Datos";
}

<style>
    .diag-section {
        margin-bottom: 24px;
        max-width: calc(100vw - 310px);
        overflow: hidden;
    }

        .diag-section h3 {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 12px;
            color: var(--accent);
        }

    .diag-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        font-family: 'Plus Jakarta Sans', monospace;
        table-layout: auto;
    }

        .diag-table th {
            text-align: left;
            padding: 8px 10px;
            background: var(--accent);
            color: white;
            font-weight: 600;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }

            .diag-table th:first-child {
                border-radius: var(--radius-sm) 0 0 0;
            }

            .diag-table th:last-child {
                border-radius: 0 var(--radius-sm) 0 0;
            }

        .diag-table td {
            padding: 7px 10px;
            border-bottom: 1px solid var(--border-light);
            color: var(--text-secondary);
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .diag-table tbody tr:hover {
            background: var(--accent-light);
        }

    .count-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 12px;
        min-width: 32px;
        text-align: center;
    }

    .count-zero {
        background: var(--danger-light);
        color: var(--danger);
    }

    .count-low {
        background: var(--warning-light);
        color: var(--warning);
    }

    .count-good {
        background: var(--success-light);
        color: var(--success);
    }

    .count-error {
        background: var(--danger-light);
        color: var(--danger);
    }
</style>

@if (ViewBag.Error != null)
{
    <div style="background: var(--danger-light); border: 1px solid rgba(239,68,68,0.2); border-radius: var(--radius-sm); padding: 14px 16px; margin-bottom: 20px; color: var(--danger); font-size: 13px;">
        <strong>Error:</strong> @ViewBag.Error
    </div>
}

<p class="page-desc">Vista de diagnóstico — conteo de filas y datos de ejemplo de cada tabla.</p>

@if (Model.ContainsKey("counts"))
{
    <div class="card diag-section">
        <h3>Conteo de Filas por Tabla</h3>
        <div style="overflow-x: auto;">
            <table class="diag-table">
                <thead>
                    <tr>
                        <th style="width: 50%;">Tabla</th>
                        <th style="text-align: right; width: 25%;">Filas</th>
                        <th style="width: 25%;">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kvp in (Dictionary<string, int>)Model["counts"])
                    {
                        var cssClass = kvp.Value == -1 ? "count-error" : kvp.Value == 0 ? "count-zero" : kvp.Value < 5 ? "count-low" : "count-good";
                        var label = kvp.Value == -1 ? "ERROR" : kvp.Value.ToString();
                        <tr>
                            <td style="font-weight: 600; font-family: monospace; font-size: 12px;">@kvp.Key</td>
                            <td style="text-align: right;">
                                <span class="count-badge @cssClass">@label</span>
                            </td>
                            <td>
                                @if (kvp.Value == -1)
                                {
                                    <span style="color: var(--danger); font-size: 12px;">No existe o error</span>
                                }
                                else if (kvp.Value == 0)
                                {
                                    <span style="color: var(--danger); font-size: 12px;">Vacía</span>
                                }
                                else if (kvp.Value < 5)
                                {
                                    <span style="color: var(--warning); font-size: 12px;">Pocos datos</span>
                                }
                                else
                                {
                                    <span style="color: var(--success); font-size: 12px;">Con datos</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@{
        var sections = new (string key, string title)[]
        {
        ("careers", "Carreras (Top 5)"),
        ("groups", "Grupos (Top 5)"),
        ("students", "Estudiantes (Top 5)"),
        ("teachers", "Docentes (Top 5)"),
        ("persons", "Personas (Top 5)"),
        ("preinscripciones", "Preinscripciones (Top 5)"),
        ("inscripciones", "Inscripciones (Top 5)"),
        ("aspirantes", "Aspirantes (Top 5)"),
        ("aspirante_datos", "Aspirante Datos Generales (Top 5)"),
        ("aspirante_otros", "Aspirante Otros (Top 5)"),
        ("preinscripcion_otros", "Preinscripción Otros (Top 5)"),
        ("tramite_categorias", "Categorías de Trámites"),
        ("tramite_solicitudes", "Solicitudes de Trámites (Top 5)"),
        ("visitas", "Visitas Médicas (Top 5)"),
        ("salud", "Preinscripción Salud (Top 5)"),
        ("career_history", "Historial Cambio Carrera (Top 5)"),
        ("group_history", "Historial Cambio Grupo (Top 5)"),
        ("student_statuses", "Estudiantes por Estatus"),
        ("preinscripcion_statuses", "Preinscripciones por Estatus"),
        ("inscripcion_statuses", "Inscripciones por Estatus"),
        ("tramite_statuses", "Trámites por Estatus"),
        ("diagnosticos", "Top 15 Diagnósticos Médicos"),
        };
}

@foreach (var (key, title) in sections)
{
    if (Model.ContainsKey(key))
    {
        var data = Model[key] as IList<dynamic>;
        if (data != null && data.Count > 0)
        {
            <div class="card diag-section">
                <h3>@title</h3>
                <div style="overflow-x: auto;">
                    <table class="diag-table">
                        <thead>
                            <tr>
                                @foreach (var col in (IDictionary<string, object>)data[0])
                                {
                                    <th>@col.Key</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in data)
                            {
                                <tr>
                                    @foreach (var col in (IDictionary<string, object>)row)
                                    {
                                        <td title="@col.Value">@col.Value</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="card diag-section">
                <h3>@title</h3>
                <p class="no-data">Sin datos</p>
            </div>
        }
    }
}